# Connexion Postgres (obligatoire en production ; en dev, la base du docker-compose est utilisée par défaut)
DATABASE_URL=postgresql://todocook:todocook@localhost:5432/todocook

# Migrations automatiques au premier accès à la base (true par défaut).
# En production, préférer DB_AUTO_MIGRATE=false et lancer `npm run db:migrate` au déploiement.
# DB_AUTO_MIGRATE=false

# Compte de démonstration créé par `npm run db:seed -- --demo`
# SEED_DEMO_EMAIL=demo@todocook.local
# SEED_DEMO_PASSWORD=choisissez-un-mot-de-passe

# URL de l'API pour le front web (optionnel : même origine par défaut)
# NEXT_PUBLIC_API_URL=https://your-server.com

# Adresse publique de l'application (liens envoyés par e-mail). Obligatoire en production.
# APP_URL=https://todocook.example.fr

# Envoi des e-mails (mot de passe oublié) via l'API transactionnelle Brevo.
# Sans clé, en développement, le lien de réinitialisation est affiché dans la console du serveur.
# BREVO_API_KEY=
# MAIL_FROM_EMAIL=no-reply@todocook.example.fr   # expéditeur validé dans Brevo
# MAIL_FROM_NAME=TodoCook
