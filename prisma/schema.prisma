generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  firstName String
  lastName  String
  age       Int?
  weight    Float?
  height    Float?
  gender    String?
  activityLevel String?
  dailyCalorieGoal Int @default(2000)
  dailyProteinGoal Float @default(50)
  dailyCarbs  Float @default(250)
  dailyFat    Float @default(70)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pantryItems  PantryItem[]
  mealPlans    MealPlan[]
  userRecipes  UserRecipe[]
  dailyLogs    DailyLog[]
}

model Ingredient {
  id        Int      @id @default(autoincrement())
  name      String
  barcode   String?  @unique
  calories  Float    @default(0)
  protein   Float    @default(0)
  carbs     Float    @default(0)
  fat       Float    @default(0)
  fiber     Float    @default(0)
  unit      String   @default("g")
  imageUrl  String?
  brand     String?
  category  String?
  createdAt DateTime @default(now())

  pantryItems      PantryItem[]
  recipeIngredients RecipeIngredient[]
}

model Recipe {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  instructions String?
  prepTime    Int?
  cookTime    Int?
  servings    Int      @default(1)
  calories    Float    @default(0)
  protein     Float    @default(0)
  carbs       Float    @default(0)
  fat         Float    @default(0)
  imageUrl    String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredients  RecipeIngredient[]
  mealPlans    MealPlan[]
  userRecipes  UserRecipe[]
}

model RecipeIngredient {
  id           Int        @id @default(autoincrement())
  recipeId     Int
  ingredientId Int
  quantity     Float
  unit         String     @default("g")

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([recipeId, ingredientId])
}

model PantryItem {
  id           Int        @id @default(autoincrement())
  userId       Int
  ingredientId Int
  quantity     Float      @default(1)
  unit         String     @default("g")
  expiresAt    DateTime?
  createdAt    DateTime   @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([userId, ingredientId])
}

model MealPlan {
  id       Int      @id @default(autoincrement())
  userId   Int
  recipeId Int
  date     DateTime
  mealType String   @default("dejeuner")
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model UserRecipe {
  id       Int @id @default(autoincrement())
  userId   Int
  recipeId Int

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
}

model DailyLog {
  id       Int      @id @default(autoincrement())
  userId   Int
  date     DateTime
  calories Float    @default(0)
  protein  Float    @default(0)
  carbs    Float    @default(0)
  fat      Float    @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}
